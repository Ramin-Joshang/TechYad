# ==========================================
# TechYad Production Environment Configuration
# ==========================================

# Server Ports & Host
PORT=5000
FRONTEND_PORT=4000
NODE_ENV=production

# Public & Internal Domains
APP_URL=https://tecyad.ir
NEXT_PUBLIC_APP_URL=https://tecyad.ir
FRONTEND_URL=https://tecyad.ir
INTERNAL_BACKEND_URL=http://127.0.0.1:5000/api
NEXT_PUBLIC_API_URL=/api

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/tecyad

# Security & Authentication Secrets
JWT_SECRET=super_strong_jwt_production_secret_key_at_least_32_characters
JWT_REFRESH_SECRET=super_strong_jwt_refresh_production_secret_key_at_least_32_characters

# SMS Provider Credentials (Pattern: TecyadOTP)
SMS_PROVIDER=kavenegar
SMS_API_KEY=your_kavenegar_or_ippanel_api_key_here
SMS_SENDER_NUMBER=10008663
SMS_OTP_PATTERN=TecyadOTP

# Payment Gateways (Configured via Super Admin or Environment)
ZARINPAL_MERCHANT_ID=
SAMAN_TERMINAL_ID=15859910
SAMAN_PASSWORD=
SNAPP_PAY_CLIENT_ID=
SNAPP_PAY_CLIENT_SECRET=

