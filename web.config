<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS URL Rewrite & Reverse Proxy Configuration for TechYad (tecyad.ir)
  Deployment Topology:
    - Main Domain: https://tecyad.ir
    - Frontend: Next.js running internally on 127.0.0.1:4000
    - Backend: Express running internally on 127.0.0.1:5000
    - Reverse Proxy: IIS with Application Request Routing (ARR) & URL Rewrite module enabled
-->
<configuration>
  <system.webServer>
    <!-- Configure Request Size Limits (up to 50MB for media/video uploads) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- 1. Enforce HTTPS in Production -->
        <rule name="TechYad - Redirect HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
            <add input="{HTTP_HOST}" pattern="^127\.0\.0\.1" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Swagger API Documentation -> Backend Express (Port 5000) -->
        <rule name="TechYad - Swagger Docs to Backend" stopProcessing="true">
          <match url="^api-docs(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:5000/api-docs{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!-- 3. Static Uploads -> Backend Express (Port 5000) -->
        <rule name="TechYad - Uploads to Backend" stopProcessing="true">
          <match url="^uploads/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:5000/uploads/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!-- 4. Official API Routes (/api/*) -> Backend Express (Port 5000)
             Preserves /api path without double-prefixing or removing prefix -->
        <rule name="TechYad - API Routes to Backend" stopProcessing="true">
          <match url="^api(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:5000/api{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!-- 5. All Website Traffic -> Next.js Frontend (Port 4000) -->
        <rule name="TechYad - Web Traffic to Nextjs" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
      <outboundRules>
        <!-- Security Headers for Production -->
        <rule name="Add Strict-Transport-Security" enabled="true">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <action type="Rewrite" value="max-age=31536000; includeSubDomains; preload" />
        </rule>
        <rule name="Add X-Content-Type-Options" enabled="true">
          <match serverVariable="RESPONSE_X_Content_Type_Options" pattern=".*" />
          <action type="Rewrite" value="nosniff" />
        </rule>
        <rule name="Add X-XSS-Protection" enabled="true">
          <match serverVariable="RESPONSE_X_XSS_Protection" pattern=".*" />
          <action type="Rewrite" value="1; mode=block" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Configure MIME types for Next.js modern assets and fonts -->
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
